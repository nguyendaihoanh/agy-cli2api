# Server Binding & Security
HOST=127.0.0.1
PORT=7862
AGY2API_KEY=your_strong_secret_api_key_here
AGY2API_REQUIRE_AUTH=true
AGY2API_ALLOW_REMOTE=false

# Execution & Performance
AGY_TIMEOUT=300
AGY_POLL_INTERVAL=0.25
AGY2API_MAX_CONCURRENCY=3
AGY2API_CHUNK_SIZE=10
AGY2API_STREAM_DELAY=0.03
AGY2API_EXPOSE_REASONING=true

# Lifecycle & Storage
AGY2API_SUPPRESS_AUTOUPDATE=true
AGY2API_CLEANUP_DB=true
AGY2API_STATEFUL=false
AGY2API_MAX_SESSIONS=200

# Optional Custom Paths (leave blank to use OS defaults)
AGY_PATH=
AGY_WORKDIR=
AGY_CONVERSATIONS_DIR=
AGY2API_STATEFUL_HOME=

# Multi-Account Pool Management (comma-separated emails, leave blank by default)
AGY_PROFILES_DIR=
AGY_DEFAULT_ACCOUNT=
AGY_PREFERRED_ACCOUNTS=
AGY_EXCLUDED_ACCOUNTS=
AGY_PRIMARY_RECOVERY_SEC=900
